# Synmergia environment template.
# Copy to .env, then fill the secrets. Never commit .env or real credentials.
#
# Compose services are profile-gated. Pass the profile explicitly:
#   docker compose --profile dev up --build
#   docker compose --profile prod up --build
#   docker compose --profile headless up --build
#   docker compose --profile mesh up --build --scale shard=4

# --- runtime ---------------------------------------------------------------
START_MODE=dev
GODOT_PORT=9000
GODOT_UPSTREAM=synmergia:9000
EDGE_TRANSPORT=enet

# --- postgres / pg-bridge -------------------------------------------------
POSTGRES_DB=synmergia
POSTGRES_USER=synmergia
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_BACKEND=sqlite
PG_BRIDGE_HOST=0.0.0.0
PG_BRIDGE_PORT=8080
PG_BRIDGE_POOL=8
PG_BRIDGE_URL=http://127.0.0.1:8080

# --- redis / redis-bridge -------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_BACKEND=inmemory
REDIS_BRIDGE_HOST=0.0.0.0
REDIS_BRIDGE_PORT=8081
REDIS_BRIDGE_URL=http://127.0.0.1:8081

# --- julia multi-iso orchestrator ----------------------------------------
MULTI_ISO_URL=http://127.0.0.1:8090

# --- shard / mesh ---------------------------------------------------------
SHARD_ID=
SHARD_NAME=
IS_PRIMARY=
MESH_AUTOSHARD=false
STORAGE_BACKEND=memory
CACHE_BACKEND=memory
SHARD_BUS_BACKEND=
EDGE_HTTP_PORT=8088
EDGE_HTTPS_PORT=8443

# --- TLS ------------------------------------------------------------------
# The current compose certbot service is a renewal loop; see DEPLOY.md
# section 4 before treating this as a first-issuance path.
DOMAIN=
CERT_EMAIL=

# --- auth -----------------------------------------------------------------
JWT_SECRET=
