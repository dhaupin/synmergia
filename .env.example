# Synmergia Environment Configuration
# Copy to .env and fill in values

# === Server Configuration ===
GODOT_MODE=prod
GODOT_PORT=9000
GODOT_MAX_PLAYERS=100
GODOT_SHARD_ID=shard-01

# === Database ===
POSTGRES_DB=synmergia
POSTGRES_USER=synmergia
POSTGRES_PASSWORD=change_me_in_production

# === Redis Cache ===
# Redis is used as a cache layer before Postgres
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# === SQLite (lightweight instances) ===
# Set SQLITE_ENABLED=true to use SQLite instead of Postgres
SQLITE_ENABLED=false
SQLITE_PATH=/var/lib/synmergia/data.db

# === Authentication ===
JWT_SECRET=change_me_use_strong_random_key
SESSION_DURATION=86400

# === Network ===
DOMAIN=localhost
CERT_EMAIL=admin@example.com
# SSL_CERT=/certs/fullchain.pem
# SSL_KEY=/certs/privkey.pem

# === Logging ===
LOG_LEVEL=info

# === Backup ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC
