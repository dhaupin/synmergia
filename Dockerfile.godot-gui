# Godot 4 GUI testing with Xvfb (virtual framebuffer)
# Usage: docker build -f Dockerfile.godot-gui -t synmergia-gui .
#        docker run --rm -p 6080:6080 -p 5900:5900 synmergia-gui
# Then open: http://localhost:6080/vnc.html

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install Xvfb, VNC, noVNC, and X11 libraries for Godot GUI
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    ca-certificates \
    curl \
    unzip \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libxrandr2 \
    libxcursor1 \
    libxi6 \
    libxinerama1 \
    libxrender1 \
    libgl1-mesa-glx \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Download Godot 4.7.2
RUN curl -fsSL https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip -o godot.zip && \
    unzip -q godot.zip && \
    mv Godot_v4.7.2-stable_linux.x86_64 /usr/local/bin/godot && \
    chmod +x /usr/local/bin/godot && \
    rm godot.zip

# Copy game project
WORKDIR /workspace/project/synmergia
COPY synmergia /workspace/project/synmergia

# Expose VNC and noVNC
EXPOSE 6080 5900

# Start Xvfb + VNC + noVNC
CMD ["bash", "-c", "\
    Xvfb :99 -screen 0 1920x1080x24 & \
    x11vnc -display :99 -rfbport 5900 -forever -shared & \
    websockify --web=/usr/share/novnc 6080 localhost:5900 & \
    echo 'VNC: localhost:5900 | noVNC: http://localhost:6080/vnc.html' && \
    tail -f /dev/null"]
