# Dockerfile.test-headless
# Runs Godot headless smoke tests inside Docker — no GPU or display needed.
#
# Usage:
#   docker build -f Dockerfile.test-headless -t synmergia:test .
#   docker run --rm synmergia:test
#
# Override test filter:
#   docker run --rm synmergia:test notification
#
# Mount tests from host (for development without rebuild):
#   docker run --rm -v "$(pwd)/synmergia:/workspace/project/synmergia:ro" \
#       synmergia:test

FROM ghcr.io/godotengine/godot:4.7.2-stable-alpine

# Install bash and required utilities
RUN apk add --no-cache bash curl

WORKDIR /workspace/project/synmergia

# Copy smoke tests into the image
COPY synmergia/tests/ synmergia/tests/

# Copy and set up the test runner
COPY docker/test-headless.sh /usr/local/bin/test-headless.sh
RUN chmod +x /usr/local/bin/test-headless.sh

# Smoke tests must exit non-zero on failure for CI
ENTRYPOINT ["/usr/local/bin/test-headless.sh"]
