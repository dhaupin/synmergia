; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Synmergia"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
# NOTE: Entity is NOT an autoload. It has class_name Entity in
# game/core/entities/entity.gd. Removing it from the autoload list
# means:
#   - Entity.new() works (creates a new instance)
#   - Entity.EntityType.ENEMY works (enum on the class)
#   - extends Entity works (resolved via class_name at parse time)
# Previously Entity was both an autoload and a class_name, which
# shadowed each other and broke Entity.new() in spawn_service.gd.
# See AGENTS.md "Autoloads and class_name" for the full rules.
AdapterRegistry="*res://adapters/registry.gd"
BackendFactory="*res://adapters/backend_factory.gd"
RegisterTypes="*res://core/autoload/type_registry.gd"
DebugOverlay="*res://ui/components/debug_overlay.gd"

GameLog="*res://core/autoload/logger.gd"
GameConfig="*res://core/autoload/game_config.gd"
PlayerConfig="*res://core/services/player_config.gd"
IDRegistry="*res://core/utils/id_registry.gd"
EventHub="*res://core/events/event_hub.gd"

# Services
QoSService="*res://core/autoload/qos_service.gd"
GameManager="*res://core/autoload/game_manager.gd"
NetworkManager="*res://core/autoload/network_manager.gd"
PlayerManager="*res://core/autoload/player_manager.gd"
InputManager="*res://core/autoload/input_manager.gd"
# CooldownService and PlayerLockService are autoloads (singleton access).
# They were previously called via a const preload script reference which
# yields a script, not an instance -- calling non-static methods on them
# fails. Registered before ZoneManager/InventoryService (their first
# consumers) so _ready ordering is correct.
CooldownService="*res://core/services/cooldown_service.gd"
PlayerLockService="*res://core/services/player_lock_service.gd"
DataService="*res://core/services/data_service.gd"
EntityService="*res://core/services/entity_service.gd"
ZoneManager="*res://core/services/zone_manager.gd"
FactionManager="*res://core/services/faction_manager.gd"
SpawnService="*res://core/services/spawn_service.gd"
WorldService="*res://core/services/world_service.gd"
ShardManager="*res://core/services/shard_manager.gd"
NotificationService="*res://core/services/notification_service.gd"
SecurityService="*res://core/services/security_service.gd"
AppFirewall="*res://core/utils/app_firewall.gd"
SecurityMonitor="*res://core/autoload/security_monitor.gd"
AdminCommands="*res://core/utils/admin_commands.gd"
PermissionManager="*res://core/admin/permission_manager.gd"
PlayerReporter="*res://core/admin/player_reporter.gd"
CommunityGovernance="*res://core/community/community_governance.gd"
AutoResponseService="*res://core/services/auto_response_service.gd"
ServerManager="*res://core/services/server_manager.gd"
CombatSystem="*res://core/combat/combat_system.gd"
ChatService="*res://core/services/chat_service.gd"
GuildService="*res://core/services/guild_service.gd"
PartyService="*res://core/services/party_service.gd"
LootService="*res://core/services/loot_service.gd"
TradeService="*res://core/services/trade_service.gd"
InventoryService="*res://core/services/inventory_service.gd"
AccountService="*res://core/services/account_service.gd"
LoginService="*res://core/services/login_service.gd"
FriendsService="*res://core/services/friends_service.gd"
SameAccountTransferService="*res://core/services/same_account_transfer_service.gd"
InteractionLayer="*res://core/input/interaction_layer.gd"
ScreenshotService="*res://core/services/screenshot_service.gd"
StarterKitService="*res://core/services/starter_kit_service.gd"
TargetingManager="*res://core/targeting/targeting_manager.gd"
UIManager="*res://core/ui/ui_manager.gd"
RespawnService="*res://core/services/respawn_service.gd"
DeathFeatures="*res://core/services/death_features.gd"
DialogService="*res://core/services/dialog_service.gd"
RespawnUIManager="*res://ui/respawn/respawn_ui_manager.gd"
WebhookManager="*res://core/autoload/webhook_manager.gd"
BlacksmithService="*res://core/services/blacksmith_service.gd"
SkillAcademyService="*res://core/services/skill_academy_service.gd"
AntiCheatService="*res://core/services/anticheat_service.gd"
QuestService="*res://core/services/quest_service.gd"
VaultService="*res://core/services/vault_service.gd"
FollowService="*res://core/services/follow_service.gd"
WaypointService="*res://core/services/waypoint_service.gd"
ScreenshotService="*res://core/services/screenshot_service.gd"
AchievementService="*res://core/services/achievement_service.gd"
TitleService="*res://core/services/title_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=false

[input]

