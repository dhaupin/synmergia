[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Enemy"
3d_physics/layer_3="NPC"
3d_physics/layer_4="World"
3d_physics/layer_5="Projectile"
3d_physics/layer_6="Pickup"
3d_physics/layer_7="Interactable"

[mono]

project/assembly_name="WorldSmith"

[physics]

3d/physics_engine="DEFAULT"
3d/default_gravity=20.0

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.133, 0.125, 0.161, 1)

[gdscript]
warnings/untyped_assignment=0
warnings/unsafe_property_access=0
warnings/unsafe_method_access=0
warnings/unsafe_cast=0
warnings/unsafe_call_argument=0
warnings/unsafe_self_use=0
warnings/infer_variant=0

[synmergia]

; World shape (world-building.md sec 1.6; GameManager branches on it):
; "planar" = classic world_playable, "spherical" = the spherical world.
world/shape="spherical"

; Planet scale in meters (default 100 = prototype globe, 20000 = v1 planet scale).
; planet_radius is read at runtime by globe_island.gd from this setting.
planet_radius=100.0
