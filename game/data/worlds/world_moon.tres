[resource]
script = ExtResource("1")
id = "moon"
display_name = "the pale stone"
kind = 2
offline = 2
parent_world = "main"
radius_m = 1200.0
gravity_force = 6.0
has_atmosphere = false
orbit_radius_m = 90000.0
orbit_period_days = 8.0
orbit_phase_rad = 0.7
orbit_inclination_rad = 0.12
lore = "The Watched Stone. The world builds itself here: the pale stone exists only while someone stands on it, and the builders -- the ancients, the devs -- come and go as the sky aligns. Whatever they are working on, they always come through for us. The crater pool is their newest work. The almanac's moon page was blank since the first dawn; whoever fills it will have walked farther than any road goes."
