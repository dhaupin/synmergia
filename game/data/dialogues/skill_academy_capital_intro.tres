[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "skill_academy_capital_intro"
npc_id = "npc_skill_academy_capital"
display_name = "Master Trainer"
nodes = [
    {
        "speaker": "Master Trainer",
        "text": "Greetings, warrior. The academy keeps no secret arts -- only the ones you have not earned yet. Would you rather widen what you know, or choose the one ability that will name you?",
        "choices": [
            {"text": "What is a signature ability?", "next_node": 1},
            {"text": "What do you teach here?", "next_node": 2},
            {"text": "Farewell.", "next_node": -1}
        ]
    },
    {
        "speaker": "Master Trainer",
        "text": "The one move a fighter is remembered for. You do not learn it early -- you carry a discipline to its tenth step and then you choose, once. After that the choice is yours to keep, or yours to change, at a price.",
        "choices": [
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Master Trainer",
        "text": "The shared verbs first -- a hold, a mend -- because no school owns those. Then the drills, book by book, until the stance holds under weight. The academy sells the books; the work is yours.",
        "choices": [
            {"text": "Back.", "next_node": 0}
        ]
    }
]
