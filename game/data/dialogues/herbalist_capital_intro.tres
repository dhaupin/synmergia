[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "herbalist_capital_intro"
npc_id = "npc_herbalist_capital"
display_name = "Strand Apothecary"
nodes = [
    {
        "speaker": "Strand Apothecary",
        "text": "Sea air needs different teas. Browse the shelf -- the same draughts the village sells, kept in sea-glass so the salt does not get in.",
        "choices": [
            {"text": "What is different about the coast?", "next_node": 1},
            {"text": "Do you keep the Bloom cures?", "next_node": 2},
            {"text": "Farewell.", "next_node": -1}
        ]
    },
    {
        "speaker": "Strand Apothecary",
        "text": "Damp, mostly. Damp in the joints, damp in the lungs, damp in the temper. The village brews for the treeline; I brew for the baywalk. Same herbs, heavier hand.",
        "choices": [
            {"text": "Show me the shelf.", "next_node": 3, "action_type": 6, "action_data": {"shop_id": "potions"}},
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Strand Apothecary",
        "text": "No one keeps a cure for the Bloom. I keep what quiets what it leaves behind -- a cough, a burn, a night without sleep. Anyone who tells you they hold the cure is selling you the fear, not the remedy.",
        "choices": [
            {"text": "Show me the shelf.", "next_node": 3, "action_type": 6, "action_data": {"shop_id": "potions"}},
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Strand Apothecary",
        "text": "The shelf is yours. Mind the sea-glass -- it is older than the shop.",
        "choices": [
            {"text": "Farewell.", "next_node": -1}
        ]
    }
]
