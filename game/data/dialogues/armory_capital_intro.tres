[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "armory_capital_intro"
npc_id = "npc_armory_capital"
display_name = "Royal Armory"
nodes = [
    {
        "speaker": "Royal Armorer",
        "text": "Steel first, talk after. You came to the right bench -- the Concord does not issue gear, it keeps what it can prove. Show me your hands and I will show you the rack.",
        "choices": [
            {"text": "What do you keep here?", "next_node": 1},
            {"text": "Who forges this?", "next_node": 2},
            {"text": "Just looking. Farewell.", "next_node": -1}
        ]
    },
    {
        "speaker": "Royal Armorer",
        "text": "Weapons and plate, the honest sort. Every piece is weighed before it leaves and weighed again if it comes back bent. A blade that fails in the first hard use is a blade I do not sell twice.",
        "choices": [
            {"text": "Open the rack.", "next_node": 3, "action_type": 6, "action_data": {"shop_id": "armory"}},
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Royal Armorer",
        "text": "The strand's own smithies, mostly. The ore rides in off the coast and the coast charges what the coast charges -- so the price is what the road remembers, not what I wish it were.",
        "choices": [
            {"text": "Open the rack.", "next_node": 3, "action_type": 6, "action_data": {"shop_id": "armory"}},
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Royal Armorer",
        "text": "Rack is open. Buy, sell, or weigh it -- the ledger keeps its word either way.",
        "choices": [
            {"text": "Farewell.", "next_node": -1}
        ]
    }
]
