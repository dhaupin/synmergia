[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "master_trainer_intro"
npc_id = "npc_skill_academy_capital"
display_name = "Master Trainer"
nodes = [
    {
        "speaker": "Master Trainer",
        "text": "Greetings, warrior. You have the stance of someone who has already been hit and learned from it. Good. That is the only prerequisite I trust.",
        "choices": [
            {"text": "What do you teach?", "next_node": 1},
            {"text": "I want a signature ability.", "next_node": 2},
            {"text": "Farewell.", "next_node": -1}
        ]
    },
    {
        "speaker": "Master Trainer",
        "text": "The old arts -- the ones the machines knew before the Silence, re-taught to hands that can hold them. Open the lesson tray when you are ready.",
        "choices": [
            {"text": "Back.", "next_node": 0}
        ]
    },
    {
        "speaker": "Master Trainer",
        "text": "A signature is a promise about how you fight. You choose it at the tenth level, and you live with the choice. I will not choose it for you.",
        "choices": [
            {"text": "Back.", "next_node": 0}
        ]
    }
]
