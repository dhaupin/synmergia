script = ExtResource("1")
id = "mystery_the_first_vault"
display_name = "The Vault That Answered the Sky"
riddle = "The first vault kept one question above its door, and its builders claimed the answer was already written -- nightly, overhead, for anyone who kept the ledger of lights. Speak the four words in the order the sky said them on the day the vault last answered."
