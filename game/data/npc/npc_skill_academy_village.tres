[resource]
script = ExtResource("1")
id = "npc_skill_academy_village"
display_name = "Warden Trainer"
description = "A retired campaign warden who drills the village's young fighters. The Academy's reach is long -- the basics are taught wherever a student stands."
level = 40
faction = "friendly"
greeting = "Feet square, blade steady. What shall we drill?"
farewell = "Return when your stance falters."
location_type = 2
spawn_offset = Vector3(2, 0, 4)
zone_id = "zone_village_center"
includes = [
  {"type": "dialogue", "dialogue_id": "warden_trainer_intro"},
  {"type": "offering", "ref_id": "skill_academy"}
]
