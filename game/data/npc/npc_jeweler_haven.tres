script = ExtResource("1")
id = "npc_jeweler_haven"
display_name = "Haven Jeweler"
description = "Marsh Piper, the shore's pearl-cutting jeweler. She braids kelp, cuts abyss pearls, and prices the Concord's debt steel off her own bench."
level = 1
faction = "friendly"
scene_path = "res://scenes/npcs/merchant_general.tscn"
greeting = "Careful with that on my bench, dear. Everything here has already been one tragedy (pearl, dive, or debt)."
farewell = "Mind the clasp of anything you bought from me. The sea tests hasty work."
