script = ExtResource("1")
id = "npc_ferryman_sundered"
display_name = "Old Brack, the Ferryman"
description = "He kept the crossing alive when the strait closed. Now that the Sundered Sea is open again, the barque sails twice a tide -- if someone pays the crew."
level = 1
faction = "friendly"
scene_path = "res://scenes/npcs/merchant_general.tscn"
greeting = "Tide's turning. You crossing, or just gawking at the wreck?"
farewell = "Mind the shoal. She took the barque; she'll take slower ships."
