[resource]
script = ExtResource("1")
id = "npc_banker_village"
display_name = "Village Banker"
description = "The keep's vault keeper. Deposits, withdrawals, and the safe-keeping of coin that adventurers lose to the sea."
level = 1
faction = "friendly"
greeting = "Coin or keepsakes? The vault holds both."
farewell = "The vault keeps its word."
location_type = 2
spawn_offset = Vector3(4, 0, 2)
zone_id = "zone_village_center"
includes = [{"type": "offering", "ref_id": "bank_vault"}]
