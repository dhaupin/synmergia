script = ExtResource("1")
id = "sporebound_matriarch"
display_name = "The Sporebound Matriarch"
description = "The Bloom's oldest node, down where the runoff pools and the elevator sleeps. A vast many-limbed mass hunched over a brood it keeps making and cannot stop making, each new creature grown to tend a garden whose gardener never came back. Violet mantle, magenta eyes by the dozen, a cracked agent-core for a heart. It is not a villain. It is a mother with no one left to raise."
