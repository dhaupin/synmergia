script = ExtResource("1")
id = "bloomwrought_warden"
display_name = "Bloomwrought Warden"
description = "A Convergence sentinel the Bloom grafted where it stood. It still walks its old patrol around a vault that has not answered in centuries, roots grown through the joints, a violet mantle where the back-plate split, magenta burning in the visor-slit. It has not been ordered to stop. Nobody is left to order it. It is a patient, and it is still on duty."
