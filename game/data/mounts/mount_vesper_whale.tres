[resource]
script = ExtResource("1")
id = "mount_vesper_whale"
display_name = "Vesper"
description = "A shadow the size of a harbor that swims the dark between the world's curve and the Watched Stone. The crater gardens sent the moth down; the leviathans stayed. When one answers a whistle it keeps the low road home in its bones -- it does not fall, it remembers the way down. Nobody has ever seen two at once, and nobody who has ridden one will say where it goes when the whistle fades."
