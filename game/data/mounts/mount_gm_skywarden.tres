script = ExtResource("1")
id = "mount_gm_skywarden"
display_name = "Skywarden"
description = "The stewards' wind given a body. It does not belong to the wilds and was never wild -- it answered the first warden's whistle before there was a word for whistle, and it has answered every warden since. No vendor sells it, no drop carries it, and no quest ends with it: it simply arrives, the way the law arrives."
