[gd_resource type="Resource" script_class="ShardParameterDefinition" load_steps=2 format=3 uid://uid://respawn_rate_modifier]

[sub_resource type="Resource" id="ShardParameterDefinition_respawn_rate_modifier"]
name = "respawn_rate_modifier"
type = "float"
default_value = 1.0
critical = false
description = "Multiplier applied to base respawn timers on this shard. Non-critical: coalesced for 5 minutes so bursts of respawn config writes do not spam the state tree."
version = 1