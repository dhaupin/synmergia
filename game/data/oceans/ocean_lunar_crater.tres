[gd_resource type="Resource" script_class="OceanVolume" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/ocean_volume.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ocean_lunar_crater"
display_name = "The Builder's Pool"
surface_height = -12.0
floor_is_radial = true
floor_center = Vector3(0, 0, 0)
floor_radius = 980.0
waterline_is_radial = true
surface_radius = 1188.0
pool_dir = Vector3(0, 1, 0)
pool_angular_radius = 0.305
max_depth = 230.0
current_direction = Vector3(0, 0, 1)
current_strength = 0.0
pressure_per_meter = 0.0
salinity = 0.35
ambient_fog_color = Color(0.12, 0.22, 0.34, 1)
ambient_fog_density = 0.02
ambient_sounds = Array[String](["ocean_deep", "ocean_lap"])
lore = "The builders filled a crater to learn what water is, and the dish kept growing until it was an inland sea: three hundred and sixty paces across, two hundred deep, filled to within a stone's throw of its own rim. Tame by design -- no squeeze, no crush, a slow turn the way the pale stone turns -- the workshop pool where the world works on itself. Whatever swims here first swims on the moon."
