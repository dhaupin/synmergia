[resource]
script = ExtResource("1")
id = "quest_sentinel_wake"
display_name = "The Sentinel's Toll"
description = "Fenwick pays standing tolls, not dreams: the Sentinel hauls the garden's debris through the moor lanes on the standing tide and the lanes pay for it in rebuilt decks. It grows its pearl bigger every season and drags the fibers back with it. Take the wake off the lane when it rises -- once is enough for a season's ledger, and the ore it swallows pays the forge."
