script = ExtResource("1")
id = "quest_tide_salvage"
display_name = "The Tide's Tithe"
description = "Fenwick rebuilt six barque decks with salvage the tide took back the first time, so he knows the arithmetic: what the sea keeps standing near it can be hauled off it. The tidecursed keep snagging live fibers in their kelp drag when they haul past the shallows. Clear five of them off the moor lanes and bring the drag's fibers home -- a clean lane is worth a seasonal deck."
