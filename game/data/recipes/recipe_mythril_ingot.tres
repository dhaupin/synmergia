[resource]
script = ExtResource("1")
id = "recipe_mythril_ingot"
display_name = "Temper Mythril Ingot"
description = "The pale ore refuses a lone fire. A golden ingot carries the temper through; the mythril forgives the gold being there."
station = 1
inputs = [{"item_id": "res_ore_mythril", "qty": 2}, {"item_id": "res_golden_ingot", "qty": 1}]
output = {"item_id": "res_mythril_ingot", "qty": 1}
byproducts = [{"item_id": "res_slag", "qty": 1}]
craft_time_sec = 0.0
required_level = 10
failure_rate = 0.15
