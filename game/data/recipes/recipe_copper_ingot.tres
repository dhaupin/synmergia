[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/recipe_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "recipe_copper_ingot"
display_name = "Smelt Copper Ingot"
description = "Two copper ores, one ingot, and the slag the forge always keeps. Copper bends before it breaks."
station = 1
inputs = [{"item_id": "res_copper_ore", "qty": 2}]
output = {"item_id": "res_copper_ingot", "qty": 1}
byproducts = [{"item_id": "res_slag", "qty": 1}]
craft_time_sec = 0.0
required_level = 1
failure_rate = 0.1
