[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/recipe_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "recipe_silver_warhammer"
display_name = "Forge Silver Warhammer"
description = "A silver head on a timber haft, weighted to fall. Four ingots for a hammer that does not need to be quick."
station = 1
inputs = [{"item_id": "res_silver_ingot", "qty": 4}, {"item_id": "res_timber", "qty": 2}]
output = {"item_id": "wep_silver_warhammer", "qty": 1}
byproducts = [{"item_id": "res_slag", "qty": 2}]
craft_time_sec = 0.0
required_level = 10
failure_rate = 0.1
