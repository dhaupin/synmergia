description = "The pale ore hates the forge less if the fire is patient. Two ores, one ingot, a little more slag."
station = 1
inputs = [{"item_id": "res_ore_silver", "qty": 2}]
output = {"item_id": "res_silver_ingot", "qty": 1}
byproducts = [{"item_id": "res_slag", "qty": 1}]
