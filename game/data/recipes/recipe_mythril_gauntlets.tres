[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/schemas/recipe_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "recipe_mythril_gauntlets"
display_name = "Forge Mythril Gauntlets"
description = "Mythril-shard knuckles riveted over sinew-wrapped plate. Light enough to work in, hard enough to end the argument."
station = 1
inputs = [{"item_id": "res_mythril_shard", "qty": 2}, {"item_id": "res_scale_plate", "qty": 2}]
output = {"item_id": "arm_mythril_gauntlets", "qty": 1}
byproducts = [{"item_id": "res_slag", "qty": 1}]
craft_time_sec = 0.0
required_level = 11
failure_rate = 0.1
