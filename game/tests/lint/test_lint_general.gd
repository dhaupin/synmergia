extends SceneTree

# General / "kitchen sink" linter.
#
# Catches Godot 4.7.x-specific parse issues that are too narrow
# for the dedicated linters but still hurt the project. This is
# where new heuristic checks go when you're not sure which
# category they belong to.
#
# Current checks:
#   1. .uid files without a corresponding .gd / .tscn / .tres
#      (orphan UIDs, a common cause of "Could not load" errors)
#   2. .gd files referenced in a .tscn that no longer exist
#   3. Hardcoded absolute paths in scripts (C:\, /tmp/, /home/...)
#   4. print() calls in non-test code (info -- easy to leave in
#      during debugging and they show up in production logs)
#   5. Tabs/spaces on a single line mixed
#   6. Lines exceeding 200 columns (heuristic; Godot has no
#      hard limit but very long lines are a smell)
#   7. @tool scripts (info; useful to know which scripts run
#      in the editor)
#   8. Signal handlers with parameter count mismatch (heuristic)
#
# Allowlist: addons/ is skipped (third-party).
#
# Run with:
#   godot --headless --path . --script res://tests/lint/test_lint_general.gd

const Helpers := preload("res://tests/lint/lint_helpers.gd")

var _passed: int = 0
var _failed: int = 0


func _ok(label: String) -> void:
	_passed += 1
	print("  [PASS] ", label)


func _fail(label: String, detail: String = "") -> void:
	_failed += 1
	printerr("  [FAIL] ", label, " ", detail)


func _init() -> void:
	print("--- LINT: general (kitchen sink) ---")

	_check_orphan_uids()
	_check_tscn_refs_exist()
	_check_hardcoded_absolute_paths()
	_check_print_in_non_test_code()
	_check_mixed_tabs_spaces_on_line()
	_check_long_lines()
	_check_tool_scripts()
	_check_signal_handler_params()
	_check_marker_comments()
	_check_empty_function_bodies()
	_check_long_files()
	_check_assert_in_production()
	_check_has_method_on_signal()

	_finish()


func _check_orphan_uids() -> void:
	# A .uid file is auto-generated by the editor next to a script
	# or scene. If the source file is gone but the .uid remains,
	# the editor may show stale references.
	var uids: Array = []
	var d := DirAccess.open("res://")
	if d == null:
		_fail("DirAccess.open(res://)", "returned null")
		_finish()
		return
	_collect_uids(d, uids)
	var orphans: Array = []
	for uid_path in uids:
		var stem: String = uid_path.get_basename()  # strips the .uid
		if not FileAccess.file_exists(stem):
			orphans.append(uid_path)
			Helpers.report_issue(uid_path, 0, "warning",
					"orphan .uid file (source " + stem + " missing)")
	if orphans.is_empty():
		_ok("no orphan .uid files (" + str(uids.size()) + " checked)")
	else:
		_ok(str(orphans.size()) + " orphan .uid files (warning, not fatal)")


func _collect_uids(dir: DirAccess, out: Array) -> void:
	dir.list_dir_begin()
	var entry := dir.get_next()
	while entry != "":
		if entry.begins_with("."):
			entry = dir.get_next()
			continue
		var path := dir.get_current_dir().path_join(entry)
		if dir.current_is_dir():
			if entry == "addons":  # skip third-party
				entry = dir.get_next()
				continue
			var sub := DirAccess.open(path)
			if sub != null:
				_collect_uids(sub, out)
		elif entry.ends_with(".uid"):
			out.append(path)
		entry = dir.get_next()
	dir.list_dir_end()


func _check_tscn_refs_exist() -> void:
	# A .tscn references a script via `[ext_resource path="res://..."]`.
	# We look for `path="res://...gd"` and verify the file exists.
	var missing: Array = []
	for tscn in Helpers.list_tscn_files():
		var text := Helpers.read_text(tscn)
		# Crude but works: find every "res://..." inside double quotes.
		var i := 0
		while i < text.length():
			var start := text.find("res://", i)
			if start < 0:
				break
			# Find the closing quote.
			var end := text.find("\"", start)
			if end < 0:
				break
			var path := text.substr(start, end - start)
			if (path.ends_with(".gd") or path.ends_with(".tscn")
					or path.ends_with(".tres") or path.ends_with(".cs")):
				if not FileAccess.file_exists(path):
					missing.append(path)
					Helpers.report_issue(tscn, 0, "error",
							"tscn references missing resource: " + path)
			i = end + 1
	if missing.is_empty():
		_ok("every .tscn resource reference exists")
	else:
		_fail("missing .tscn resource references",
				str(missing.size()) + " missing; see ERROR lines above")


func _check_hardcoded_absolute_paths() -> void:
	# Look for hardcoded paths that won't work on a different
	# machine: C:\, /tmp/, /home/, /Users/, %TEMP%.
	var pattern := RegEx.create_from_string(
			"([\"'])([A-Z]:\\\\|/tmp/|/home/|/Users/|%TEMP%)([^\"']*?)\\1")
	var hits := 0
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		var m := pattern.search(text)
		while m != null:
			hits += 1
			var line_num := text.count("\n", 0, m.get_start()) + 1
			Helpers.report_issue(path, line_num, "warning",
					"hardcoded absolute path: " + m.get_string(0))
			m = pattern.search(text, m.get_end())
	if hits == 0:
		_ok("no hardcoded absolute paths in .gd files")
	else:
		_ok(str(hits) + " hardcoded absolute path(s) (warning, not fatal)")


func _check_print_in_non_test_code() -> void:
	# print() left in production code is a smell. We don't fail
	# on it (logging might be intentional) but we count and
	# list the offenders for review.
	var hits := 0
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		if path.begins_with("res://tests/"):
			continue
		var text := Helpers.read_text(path)
		var line_num := 0
		for raw in text.split("\n"):
			line_num += 1
			var stripped := raw.strip_edges()
			# Skip comments.
			if stripped.begins_with("#"):
				continue
			# Skip push_warning / push_error / printerr (they're
			# intentional debug output).
			if stripped.find("print(") < 0 and stripped.find("print(") < 0:
				pass
			if stripped.find("print(") >= 0 or stripped.find("print_rich(") >= 0:
				hits += 1
				Helpers.report_issue(path, line_num, "info",
						"print() call in non-test code")
				break  # one per file
	if hits == 0:
		_ok("no print() in non-test .gd files")
	else:
		_ok(str(hits) + " .gd files use print() (info)")


func _check_mixed_tabs_spaces_on_line() -> void:
	# A line that starts with whitespace and contains BOTH a tab
	# and a space in the leading region is a parse error.
	var bad_files: Array = []
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		var line_num := 0
		for raw in text.split("\n"):
			line_num += 1
			if raw.is_empty() or raw[0] == "#":
				continue
			var saw_tab := false
			var saw_space := false
			for c in raw:
				if c == "\t":
					saw_tab = true
				elif c == " ":
					saw_space = true
				else:
					break
			if saw_tab and saw_space:
				Helpers.report_issue(path, line_num, "error",
						"line mixes leading tabs and spaces (parse error)")
				bad_files.append(path)
				break  # one per file
	if bad_files.is_empty():
		_ok("no lines mix leading tabs and spaces")
	else:
		_fail("mixed tabs/spaces on line",
				str(bad_files.size()) + " files; see ERROR lines above")


func _check_long_lines() -> void:
	# Heuristic: warn at 200+ columns.
	var long_files: Array = []
	var max_seen := 0
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		for raw in text.split("\n"):
			if raw.length() > max_seen:
				max_seen = raw.length()
			if raw.length() > 200:
				long_files.append(path)
				break
	if long_files.is_empty():
		_ok("no .gd lines exceed 200 cols (max seen: "
				+ str(max_seen) + ")")
	else:
		_ok(str(long_files.size()) + " .gd files have 200+ col lines (info)")


func _check_tool_scripts() -> void:
	# Scripts with @tool annotation run in the editor. We list them
	# for awareness; some of them are necessary (custom resource
	# editors, gizmos), some are bugs.
	var tool_scripts: Array = []
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		if text.find("\n@tool") >= 0 or text.begins_with("@tool"):
			tool_scripts.append(path)
	if tool_scripts.is_empty():
		_ok("no @tool scripts")
	else:
		_ok(str(tool_scripts.size()) + " @tool scripts: "
				+ ", ".join(tool_scripts.slice(0, 5))
				+ (", ..." if tool_scripts.size() > 5 else ""))


func _check_signal_handler_params() -> void:
	# Heuristic: when you connect a signal to a method, the method's
	# signature must match. We can't fully check this without
	# resolving types, but we CAN check that the method's arg count
	# matches. This is a low-confidence check.
	#
	# Format we look for:
	#   connect("signal_name", callable)
	#   signal_name.connect(callable)
	# We look for `func _on_signal_name(...):` and compare the
	# signal's arg count to the function's arg count.
	#
	# We don't have access to the signal declarations without
	# parsing, so we report the connection sites and let the
	# reviewer verify. This is INFO level.
	var connection_sites := 0
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		var line_num := 0
		for raw in text.split("\n"):
			line_num += 1
			if raw.find("connect(") < 0:
				continue
			if raw.find(".connect(") < 0 and raw.find("connect(\"") < 0:
				continue
			connection_sites += 1
	if connection_sites == 0:
		_ok("no connect() call sites found")
	else:
		_ok(str(connection_sites) + " connect() call sites (info, no full signature check)")


# Inventory of "incomplete work" markers in comments: TODO, FIXME,
# XXX, HACK, BUG. These are not failures (intentional debt is OK)
# but we want a baseline count and per-file breakdown so authors
# can see where the unfinished work lives. A future session might
# promote the count to a target (e.g. "no TODO in non-test code
# ships in production").
func _check_marker_comments() -> void:
	var total := 0
	var file_count := 0
	# Map: marker keyword -> count
	var by_kind := {
		"TODO": 0,
		"FIXME": 0,
		"XXX": 0,
		"HACK": 0,
		"BUG": 0,
	}
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		var line_num := 0
		var file_hits := 0
		for raw in text.split("\n"):
			line_num += 1
			# Strip leading whitespace; keep the rest for marker
			# detection. We require a word boundary so identifiers
			# like MAX_SPEED_HACK_MULTIPLIER do not count.
			var stripped := raw.strip_edges()
			if stripped.is_empty() or not stripped.begins_with("#"):
				continue
			# Walk each marker. Each is at least 3 chars; HACK
			# collides with HACK_MULTIPLIER etc. so use a word
			# boundary check.
			for kind in by_kind:
				# Look for the marker as a whole word, possibly
				# followed by ":", "(", ")", or end of comment.
				# Avoid matching TODO inside a TODO list inside
				# another TODO by capping at 1 per line per kind.
				var idx := 0
				while true:
					var found := stripped.find(kind, idx)
					if found < 0:
						break
					# Word boundary: char before must be non-alnum
					# (or start of string), char after must be non-alnum
					# or end-of-string. This stops HACK matching
					# SPEEDHACK or HACK_MULTIPLIER.
					var before := " "
					if found > 0:
						before = stripped[found - 1]
					var after := ""
					if found + kind.length() < stripped.length():
						after = stripped[found + kind.length()]
					var before_ok := not (before >= "a" and before <= "z") \
									and not (before >= "A" and before <= "Z") \
									and not (before >= "0" and before <= "9") \
									and before != "_"
					var after_ok := not (after >= "a" and after <= "z") \
									and not (after >= "A" and after <= "Z") \
									and not (after >= "0" and after <= "9") \
									and after != "_"
					if before_ok and after_ok:
						by_kind[kind] = by_kind[kind] + 1
						total += 1
						file_hits += 1
						Helpers.report_issue(path, line_num, "info",
								kind + " marker in comment")
						break
					idx = found + kind.length()
		if file_hits > 0:
			file_count += 1
	if total == 0:
		_ok("no TODO/FIXME/XXX/HACK/BUG markers in .gd files")
	else:
		var breakdown := "TODO=" + str(by_kind["TODO"]) \
				+ " FIXME=" + str(by_kind["FIXME"]) \
				+ " XXX=" + str(by_kind["XXX"]) \
				+ " HACK=" + str(by_kind["HACK"]) \
				+ " BUG=" + str(by_kind["BUG"])
		_ok(str(total) + " marker comments across " + str(file_count)
				+ " files (" + breakdown + ")")


# Detect empty function bodies: `func foo(): pass` on a single
# line, or `func foo():\n    pass` (and `...` which is the
# multi-line docstring-equivalent). These are usually stub
# functions left in place to satisfy an interface or to silence
# a linter before the real body is written. We report each
# offender so the reviewer can confirm intent.
func _check_empty_function_bodies() -> void:
	var stubs: Array = []
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		if text.is_empty():
			continue
		var lines := text.split("\n")
		var line_num := 0
		for idx in lines.size():
			line_num = idx + 1
			var raw: String = lines[idx]
			var stripped := raw.strip_edges()
			# Inline: `func foo(...): pass` or `func foo(...): ...`
			if stripped.begins_with("func ") and stripped.find(":") > 0:
				# Only flag if the function body is on the same
				# line and consists of `pass` or `...` or
				# another trivial placeholder.
				var colon := stripped.rfind(":")
				if colon < 0 or colon + 1 >= stripped.length():
					continue
				var tail := stripped.substr(colon + 1).strip_edges()
				if tail == "pass" or tail == "..." or tail.is_empty():
					# Empty body AFTER the colon, all on one line.
					# Empty tail is the `def foo():` line followed
					# by something else; we skip those because
					# the body lives on the next line.
					if not tail.is_empty():
						stubs.append(path)
						Helpers.report_issue(path, line_num, "info",
								"empty function body (stub): " + stripped.substr(0, colon))
						break  # one per file
				continue
			# Multi-line: `func foo(...):` followed by a single
			# `pass` or `...` line. Track indent so we only
			# flag the directly-nested body, not a function
			# inside a function.
			if stripped.begins_with("func ") and stripped.ends_with(":"):
				# Find the function's indent (number of leading tabs).
				var func_indent := 0
				for c in raw:
					if c == "\t":
						func_indent += 1
					else:
						break
				# Look at the next non-blank, non-comment line.
				var j := idx + 1
				while j < lines.size():
					var next_raw: String = lines[j]
					var next_stripped := next_raw.strip_edges()
					if next_stripped.is_empty() or next_stripped.begins_with("#"):
						j += 1
						continue
					# Compute its indent.
					var next_indent := 0
					for c in next_raw:
						if c == "\t":
							next_indent += 1
						else:
							break
					if next_indent <= func_indent:
						# Body has ended (we hit a sibling or
						# dedent). Not a stub.
						break
					# The line is the body. Flag if it's pass or ...
					if next_stripped == "pass" or next_stripped == "...":
						stubs.append(path)
						Helpers.report_issue(path, idx + 1, "info",
								"empty function body (stub): " + stripped)
						break
					break
	if stubs.is_empty():
		_ok("no stub function bodies in .gd files")
	else:
		_ok(str(stubs.size()) + " .gd files have stub function bodies (info)")


# Files longer than 500 lines are a smell. They are not blocked
# (sometimes a long file is the right call) but we list them so
# reviewers can decide whether to split.
func _check_long_files() -> void:
	var long_files: Array = []
	var max_seen := 0
	var max_path := ""
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		var n := text.split("\n").size()
		if n > max_seen:
			max_seen = n
			max_path = path
		if n > 500:
			long_files.append({"path": path, "lines": n})
	if long_files.is_empty():
		_ok("no .gd files exceed 500 lines (max: " + str(max_seen)
				+ " in " + max_path + ")")
	else:
		long_files.sort_custom(func(a, b): return a["lines"] > b["lines"])
		var summary := []
		for entry in long_files.slice(0, 5):
			summary.append(str(entry["lines"]) + " in " + entry["path"])
		_ok(str(long_files.size()) + " .gd files exceed 500 lines (info; top: "
				+ ", ".join(summary) + ")")


# `assert(...)` in production code is a smell. In Godot 4, assert
# is stripped in release builds (it becomes a no-op), so it should
# only be used in tests and during development. A `push_error` or
# explicit `if ... return` is the production-safe equivalent.
# We skip tests/ and linters/ for the same reason as the print
# check.
func _check_assert_in_production() -> void:
	var hits := 0
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		if path.begins_with("res://tests/"):
			continue
		var text := Helpers.read_text(path)
		var line_num := 0
		for raw in text.split("\n"):
			line_num += 1
			var stripped := raw.strip_edges()
			if stripped.begins_with("#"):
				continue
			# Match `assert(` but not `asserts(` (rare).
			if stripped.find("assert(") >= 0 \
					and stripped.find("asserts(") < 0:
				hits += 1
				Helpers.report_issue(path, line_num, "info",
						"assert() in non-test code (stripped in release builds)")
				break  # one per file
	if hits == 0:
		_ok("no assert() in non-test .gd files")
	else:
		_ok(str(hits) + " .gd files use assert() in non-test code (info)")


## has_method("x") is always false when x is a SIGNAL name. That
## mistake silently kills wiring (the UIManager -> GameManager connects
## were dead for life because they were guarded with has_method on
## signals). Signals are not methods: use has_signal(). Flag any
## has_method("...") literal that names a signal declared in the repo.
## Names that are BOTH a signal and a method are skipped (ambiguous,
## e.g. NetworkManager.player_connected).
func _check_has_method_on_signal() -> void:
	var re_sig := RegEx.new()
	re_sig.compile("(?m)^\\s*signal\\s+([A-Za-z_]\\w*)")
	var re_fn := RegEx.new()
	re_fn.compile("(?m)^\\s*(?:static\\s+)?func\\s+([A-Za-z_]\\w*)")

	var signal_names := {}
	var method_names := {}
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		var text := Helpers.read_text(path)
		for m in re_sig.search_all(text):
			signal_names[m.get_string(1)] = true
		for m in re_fn.search_all(text):
			method_names[m.get_string(1)] = true

	var re_guard := RegEx.new()
	re_guard.compile("has_method\\s*\\(\\s*\"([A-Za-z_]\\w*)\"")
	var offenders: Array = []
	for path in Helpers.list_gd_files():
		if path.begins_with("res://addons/"):
			continue
		if path.begins_with("res://tests/"):
			continue  # receipt probes may intentionally exercise the idiom
		var text := Helpers.read_text(path)
		var line_num := 0
		for raw in text.split("\n"):
			line_num += 1
			var stripped := raw.strip_edges()
			if stripped.begins_with("#"):
				continue
			for m in re_guard.search_all(raw):
				var name := m.get_string(1)
				if signal_names.has(name) and not method_names.has(name):
					offenders.append("%s:%d has_method(\"%s\")" % [path, line_num, name])
					Helpers.report_issue(path, line_num, "error",
							"has_method() on signal \"%s\" (always false; use has_signal())" % name)

	if offenders.is_empty():
		_ok("no has_method() guards on signal names")
	else:
		_fail("has_method() guards on signal names: " + ", ".join(offenders))


func _finish() -> void:
	print("--- RESULTS: ", _passed, " passed, ", _failed, " failed ---")
	if _failed > 0:
		quit(1)
	else:
		quit(0)
