{
  "name": "synmergia-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "sync:data": "tsx scripts/sync_godot_data.ts",
