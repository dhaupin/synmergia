# Godot
.godot/
*.import
# Godot 4.4+ stable resource identifiers. Regenerated on first import.
# We don't track them so the public repo stays clean of engine-generated
# files; Godot will rebuild them on the first local import.
*.uid

# Build outputs
*.pck
*.exe
*.dll
*.wasm
*.tsbuildinfo
/builds/

# Whitelist web deployment exports
!web/*.pck
!web/*.wasm
!web/*.js

# Web frontend artifacts
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# Dev-session captures (screenshots from play drivers stay local)
game/captures/

# IDE
*.code-workspace
.vscode/
*.sublime-*

# Temp
*.tmp
*.bak
*.log
*.cache

# Local Godot engine binary (downloaded into ./tools/ for runtime checks).
# The repo's official build process is documented in AGENTS.md.
tools/

# Media captures
# captures/          # UN-IGNORED — track screenshots/videos in version control
# Re-ignore if you want local-only captures:
# captures/

.kilo-godot/

# Python
__pycache__/
*.pyc
*.pyo
