# Synmergia Full Stack - Complete development/testing environment
# Includes: Godot (server + GUI + export) + Web + WebSocket + Julia + dev tools
#
# Usage:
#   docker build -f Dockerfile.synmergia-full -t synmergia-full .
#   docker run --rm -p 80:80 -p 443:443 -p 8080:8080 -p 5900:5900 -p 9000:9000 synmergia-full
#
# Services:
#   - Port 80/443: Nginx web server (serves Godot HTML5 export)
#   - Port 8080: noVNC web interface
#   - Port 5900: VNC for GUI
#   - Port 9000: WebSocket for Godot multiplayer (ENet)

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV GOPATH=/go

# ============================================================================
# Base tools
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    unzip \
    ca-certificates \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Godot 4.7.2
# ============================================================================
RUN curl -fsSL https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip -o godot.zip && \
    unzip -q godot.zip && \
    mv Godot_v4.7.2-stable_linux.x86_64 /usr/local/bin/godot && \
    chmod +x /usr/local/bin/godot && \
    rm godot.zip

# Godot export templates (for HTML5 export)
RUN curl -fsSL https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_export_templates.tpz -o templates.tpz && \
    mkdir -p ~/.local/share/godot/export_templates/4.7.2.stable && \
    unzip -q templates.tpz -d ~/.local/share/godot/export_templates/4.7.2.stable && \
    mv ~/.local/share/godot/export_templates/4.7.2.stable/templates/* ~/.local/share/godot/export_templates/4.7.2.stable/ && \
    rm templates.tpz

# ============================================================================
# Godot GUI deps (Xvfb + VNC)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libxrandr2 \
    libxcursor1 \
    libxi6 \
    libxinerama1 \
    libxrender1 \
    libxkbcommon0 \
    libgl1-mesa-glx \
    libasound2 \
    libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Web server (Nginx)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Julia (for scientific computing/calculations)
# ============================================================================
RUN curl -fsSL https://julialang-s3.julialang.org/bin/linux/x64/1.11/julia-1.11.1-linux-x86_64.tar.gz -o julia.tar.gz && \
    tar -xzf julia.tar.gz -C /opt && \
    ln -s /opt/julia-1.11.1/bin/julia /usr/local/bin/julia && \
    rm julia.tar.gz

# ============================================================================
# Go (for WebSocket server / custom tools)
# ============================================================================
RUN curl -fsSL https://go.dev/dl/go1.23.1.linux-amd64.tar.gz -o go.tar.gz && \
    tar -C /usr/local -xzf go.tar.gz && \
    rm go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"

# ============================================================================
# Python (for scripts/automation)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# WebSocket support (websockify for noVNC, plus Go WebSocket lib)
# ============================================================================
RUN pip3 install --no-cache-dir --break-system-packages websockify

# ============================================================================
# Application setup
# ============================================================================
WORKDIR /workspace/project/synmergia

# Copy game project
COPY synmergia /workspace/project/synmergia

# Create directories
RUN mkdir -p /var/www/html \
    /workspace/project/synmergia/exports \
    /etc/nginx/ssl \
    /workspace/project/synmergia/logs

# Nginx config
RUN cat > /etc/nginx/sites-available/default << 'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    root /var/www/html;
    index index.html index.htm;
    
    server_name _;
    
    location / {
        try_files $uri $uri/ =404;
    }
    
    # Godot HTML5 export goes here
    location /game/ {
        try_files $uri $uri/ /game/index.html;
    }
    
    # WebSocket proxy for Godot multiplayer
    location /ws/ {
        proxy_pass http://localhost:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
EOF

# SSL self-signed cert for HTTPS
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/nginx.key \
    -out /etc/nginx/ssl/nginx.crt \
    -subj "/C=US/ST=State/L=City/O=Synmergia/CN=localhost"

# Expose ports
EXPOSE 80 443 8080 5900 9000

# Start all services
CMD ["bash", "-c", "\
    # Start Xvfb\n\
    Xvfb :99 -screen 0 1920x1080x24 &\n\
    \n\
    # Start VNC server\n\
    x11vnc -display :99 -rfbport 5900 -forever -shared -nopw &\n\
    \n\
    # Start noVNC websocket proxy\n\
    websockify --web=/usr/share/novnc 6080 localhost:5900 &\n\
    \n\
    # Start WebSocket server (placeholder - Godot handles this natively via ENet)\n\
    # In production, you'd run: godot --headless --port 9000\n\
    socat TCP-LISTEN:9000,fork,reuseaddr SYSTEM:\"echo 'WebSocket ready'\" &\n\
    \n\
    # Start Nginx\n\
    nginx &\n\
    \n\
    echo '============================================' && \
    echo ' Synmergia Full Stack Running' && \
    echo '============================================' && \
    echo ' Web (HTTP):      http://localhost' && \
    echo ' Web (HTTPS):     https://localhost' && \
    echo ' noVNC:          http://localhost:6080/vnc.html' && \
    echo ' VNC:            localhost:5900' && \
    echo ' WebSocket:       localhost:9000' && \
    echo ' Godot Server:    godot --headless --path /workspace/project/synmergia' && \
    echo ' Godot GUI:       DISPLAY=:99 godot --path /workspace/project/synmergia' && \
    echo '============================================' && \
    tail -f /dev/null"]
