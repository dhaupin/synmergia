; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Synmergia"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
RegisterTypes="*res://core/autoload/type_registry.gd"

GameLog="*res://core/autoload/logger.gd"
GameConfig="*res://core/autoload/game_config.gd"
QoSService="*res://core/autoload/qos_service.gd"
GameManager="*res://core/autoload/game_manager.gd"
NetworkManager="*res://core/autoload/network_manager.gd"
PlayerManager="*res://core/autoload/player_manager.gd"
InputManager="*res://core/autoload/input_manager.gd"
DataService="*res://core/services/data_service.gd"
EntityService="*res://core/services/entity_service.gd"
EventBus="*res://core/services/event_bus.gd"
ZoneManager="*res://core/services/zone_manager.gd"
FactionManager="*res://core/services/faction_manager.gd"
SpawnService="*res://core/services/spawn_service.gd"
WorldService="*res://core/services/world_service.gd"
ShardManager="*res://core/services/shard_manager.gd"
NotificationService="*res://core/services/notification_service.gd"
SecurityService="*res://core/services/security_service.gd"
AppFirewall="*res://core/utils/app_firewall.gd"
SecurityMonitor="*res://core/autoload/security_monitor.gd"
AdminCommands="*res://core/utils/admin_commands.gd"
PermissionManager="*res://core/admin/permission_manager.gd"
PlayerReporter="*res://core/admin/player_reporter.gd"
CommunityGovernance="*res://core/community/community_governance.gd"
AutoResponseService="*res://core/services/auto_response_service.gd"
ServerManager="*res://core/services/server_manager.gd"
ChatService="*res://core/services/chat_service.gd"
GuildService="*res://core/services/guild_service.gd"
PartyService="*res://core/services/party_service.gd"
LootService="*res://core/services/loot_service.gd"
TradeService="*res://core/services/trade_service.gd"
InventoryService="*res://core/services/inventory_service.gd"
AccountService="*res://core/services/account_service.gd"
SameAccountTransferService="*res://core/services/same_account_transfer_service.gd"
InteractionLayer="*res://core/input/interaction_layer.gd"
TargetingManager="*res://core/targeting/targeting_manager.gd"
UIManager="*res://core/ui/ui_manager.gd"
RespawnService="*res://core/services/respawn_service.gd"
DeathFeatures="*res://core/services/death_features.gd"
RespawnUIManager="*res://ui/respawn/respawn_ui_manager.gd"
WebhookManager="*res://core/autoload/webhook_manager.gd"
BlacksmithService="*res://core/services/blacksmith_service.gd"
AntiCheatService="*res://core/services/anticheat_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=false

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}
