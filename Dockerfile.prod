# Synmergia Production Dockerfile
# Minimal production image with Godot headless server
#
# Usage:
#   docker build -f Dockerfile.prod -t synmergia:prod .
#   docker run -d -p 9000:9000 synmergia:prod

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Non-root user for security
RUN groupadd -r synmergia && useradd -r -g synmergia synmergia

# Runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Godot headless server
ARG GODOT_VERSION=4.7.2
RUN curl -fsSL "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip" \
    -o godot.zip && \
    unzip -q godot.zip && \
    mv Godot_v${GODOT_VERSION}-stable_linux.x86_64 /usr/local/bin/godot && \
    chmod +x /usr/local/bin/godot && \
    rm godot.zip

# Application
WORKDIR /workspace/project/synmergia
COPY synmergia/ ./synmergia/

# Fix permissions
RUN chown -R synmergia:synmergia /workspace/project/synmergia

USER synmergia

# Expose game port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Run headless server
CMD ["/usr/local/bin/godot", "--headless", "--path", "/workspace/project/synmergia"]
