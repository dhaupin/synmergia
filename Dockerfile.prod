# Synmergia Production Dockerfile
# Multi-stage build for minimal production image

# === Base Stage ===
FROM debian:bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Godot server binary (headless)
# Download from https://github.com/godotengine/godot/releases
ARG GODOT_VERSION=4.7.2
ARG GODOT_HASH=abc123...
RUN curl -sSL "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip" \
    -o godot.zip && \
    unzip -q godot.zip && \
    mv Godot_v${GODOT_VERSION}-stable_linux.x86_64 /usr/local/bin/godot && \
    chmod +x /usr/local/bin/godot && \
    rm godot.zip

# === Production Stage ===
FROM base AS production

ENV DEBIAN_FRONTEND=noninteractive

# Runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Application
WORKDIR /workspace/project/synmergia

COPY synmergia/ ./synmergia/

# Health check
RUN curl -f http://localhost/health || true

# Expose game port
EXPOSE 9000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Run headless server
CMD ["/usr/local/bin/godot", "--headless", "--path", "/workspace/project/synmergia"]

# === Development Stage ===
FROM base AS development

ENV DEBIAN_FRONTEND=noninteractive

# Dev dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    nginx \
    ffmpeg \
    imagemagick \
    python3 \
    curl \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/*

# VNC/noVNC setup
RUN mkdir -p /workspace/project/synmergia /root/.vnc && \
    echo "password" | vncpasswd -f > /root/.vnc/passwd && \
    chmod 600 /root/.vnc/passwd

# Application
COPY synmergia/ ./synmergia/
COPY docker/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Xvfb virtual display
ENV DISPLAY=:99

# Expose ports
EXPOSE 80 443 6080 5900 9000

ENTRYPOINT ["/entrypoint.sh"]
